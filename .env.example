# Copy to .env (local) or set in your hosting dashboard. All values are PUBLIC.
# Leave empty to run the site on demo data (public/data/demo-content.json).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: Cloudflare Turnstile site key (free) for helpdesk bot protection
VITE_TURNSTILE_SITE_KEY=
